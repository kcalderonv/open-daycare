{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": "allow"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["cmd.exe", "/c", "npx -y @playwright/mcp@latest"],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
