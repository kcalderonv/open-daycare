{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "references": {
    "db-schema": {
      "path": "../07-DB-Schema",
      "description": "Schema de base de datos, tablas, columns y referencias a crear, esto no esta implementado, solo es para referencia."
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": "allow"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["cmd.exe", "/c", "npx -y @playwright/mcp@latest"],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
